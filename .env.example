# homologacion = pruebas (las facturas no valen) · produccion = facturas reales
ARCA_ENV=homologacion

# CUIT del garage (sin guiones) y punto de venta "Web Services" creado en ARCA
CUIT=20123456789
PUNTO_DE_VENTA=2

# Archivos del certificado (rutas relativas a esta carpeta)
CERTIFICADO=certificados/certificado.crt
CLAVE_PRIVADA=certificados/clave.key

# ¿El "Precio Unitario" del Excel ya incluye el IVA? no = se le suma 21% · si = el 21% ya está adentro
PRECIO_INCLUYE_IVA=no

# Datos que se imprimen en el PDF (no se mandan a ARCA)
NOMBRE_COMERCIAL=Garage Libertador
RAZON_SOCIAL=Garage Libertador
DOMICILIO_FISCAL=Calle 123, CABA
INGRESOS_BRUTOS=
INICIO_ACTIVIDADES=01/01/2020
CONDICION_IVA=IVA Responsable Inscripto

# Si el padrón de ARCA no responde: condición IVA para un CUIT con Factura B (6 Monotributo · 4 Exento · 5 Consumidor final)
COND_IVA_B_POR_DEFECTO=6
